{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectar/shared_boards/schema/board.schema.json",
  "title": "ConnectAR board",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "physical", "manualURL", "components", "connectors", "steps"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "rectMm": {
      "description": "Прямоугольник разъёма в миллиметрах; начало координат — левый верхний угол платы (задняя I/O-панель слева), x/y — левый верхний угол разъёма.",
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "revision": { "type": "string" },
    "physical": {
      "description": "Реальный размер платы в миллиметрах; задаёт масштаб для AR-движка.",
      "type": "object",
      "required": ["widthMm", "heightMm"],
      "additionalProperties": false,
      "properties": {
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target": {
      "description": "Эталон для image tracking. Без него AR для платы недоступен, клиенты открывают фото-режим.",
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "Фото платы строго сверху, обрезанное по краю, путь относительно папки платы.",
          "type": "string",
          "pattern": "^[^/]+\\.jpe?g$"
        }
      }
    },
    "manualURL": { "type": "string", "format": "uri" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "icons": {
            "description": "Платформенные имена иконок: ios — SF Symbol, android — Material Symbol, web — любой идентификатор.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ios": { "type": "string" },
              "android": { "type": "string" },
              "web": { "type": "string" }
            }
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "componentId"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "componentId": { "$ref": "#/$defs/id" },
          "rectMm": { "$ref": "#/$defs/rectMm" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "connectorId", "instruction", "manualPage"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "connectorId": { "$ref": "#/$defs/id" },
          "instruction": { "type": "string", "minLength": 1 },
          "manualPage": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
